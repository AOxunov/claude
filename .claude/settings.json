{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" pull --rebase --autostash"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git rev-list*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-remote*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(ls *)",
      "Bash(claude --version)",
      "WebSearch",
      "WebFetch(domain:github.com)"
    ]
  }
}